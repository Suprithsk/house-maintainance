# The backend in ../house-maintainance-be. A phone cannot reach "localhost",
# so this is the machine's LAN address — both must be on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.5:4000

# Must match APP_SECRET in the backend's .env. Sent as the x-api-key header.
# EXPO_PUBLIC_ values are embedded in the built app and readable by anyone who
# has the APK — acceptable here because the key guards one household's milk log,
# not accounts. Rotate by changing both .env files and rebuilding.
EXPO_PUBLIC_API_KEY=<copied from backend .env>
